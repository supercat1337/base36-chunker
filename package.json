{
    "name": "@supercat1337/base36-chunker",
    "version": "2.0.0",
    "description": "Split text into base36-only lines (a-z0-9, never starting with a digit) with embedded metadata and reassemble it losslessly.",
    "author": "Albert Bazaleev",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "engines": {
        "node": ">=19"
    },
    "exports": {
        ".": {
            "types": "./dist/types.d.ts",
            "import": "./dist/base36-chunker.esm.js"
        }
    },
    "types": "dist/types.d.ts",
    "scripts": {
        "test": "c8 ava",
        "clean": "shx rm -rf ./dist && shx mkdir ./dist",
        "build_esm": "rollup ./src/index.js --file ./dist/base36-chunker.esm.js --format es",
        "build_esm_bundle": "esbuild ./src/index.js --format=esm --bundle --platform=neutral --outfile=./dist/base36-chunker.esm.bundle.js",
        "gen_types": "tsc --project my.tsconfig.types.json && shx cp src/index.d.ts dist/types-temp/src/index.d.ts",
        "bundle_types": "api-extractor run --local",
        "build": "npm run clean && npm run build_esm && npm run build_esm_bundle && npm run gen_types && npm run bundle_types && shx rm -rf dist/types-temp",
        "lint": "eslint src/ tests/",
        "prepublishOnly": "npm run build && npm test"
    },
    "devDependencies": {
        "@microsoft/api-extractor": "^7.59.4",
        "ava": "^6.1.0",
        "c8": "^10.1.0",
        "esbuild": "^0.25.0",
        "eslint": "^10.15.0",
        "eslint-plugin-jsdoc": "^63.3.3",
        "globals": "^17.14.0",
        "rollup": "^4.30.0",
        "shx": "^0.4.0",
        "typescript": "^5.7.0"
    },
    "keywords": [
        "base36",
        "chunk",
        "split",
        "encode",
        "decode",
        "session",
        "text",
        "lowercase",
        "alphanumeric"
    ],
    "publishConfig": {
        "registry": "https://registry.npmjs.org"
    },
    "homepage": "https://github.com/supercat1337/base36-chunker",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/supercat1337/base36-chunker.git"
    },
    "files": [
        "dist/base36-chunker.esm.js",
        "dist/base36-chunker.esm.bundle.js",
        "dist/types.d.ts",
        "README.md",
        "LICENSE.txt"
    ],
    "ava": {
        "files": [
            "tests/**/*.test.js"
        ],
        "nodeArguments": [
            "--experimental-vm-modules"
        ],
        "extensions": [
            "js"
        ]
    }
}
